# Copy to .env locally; never commit the real .env file.
# Bootstrap username/password are used only when no .vexon-data/admin.json exists.
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
# Optional for a development server behind HTTPS; production always uses Secure cookies.
# VEXON_COOKIE_SECURE=true
VEXON_ADMIN_USERNAME=admin
# Replace this example with a unique password of at least 16 characters.
VEXON_ADMIN_PASSWORD=replace-with-a-long-random-password
# Generate with: openssl rand -hex 32. Back up securely; losing it makes the encrypted vault unreadable.
VEXON_MASTER_KEY=replace-with-64-hex-characters
VEXON_DATA_DIR=.vexon-data
VEXON_ENABLE_EXCHANGE_CONNECTIONS=false
VEXON_LIVE_TRADING=false
VEXON_ALLOWED_EXCHANGES=binance,okx,kucoin,nobitex,wallex,bitpin
VEXON_ORDER_QUOTE_LIMITS={"USDT":100}
VEXON_MAX_LIMIT_DEVIATION_PERCENT=2

# For production, terminate HTTPS at a trusted reverse proxy and set:
# NODE_ENV=production
# VEXON_ALLOWED_HOSTS=trade.example.com
# VEXON_ALLOWED_ORIGINS=https://trade.example.com
# Pre-approve any domain choices shown in Admin > Server management.
# VEXON_MANAGEABLE_ORIGINS=https://trade.example.com,https://trade-alt.example.com
# VEXON_TRUST_PROXY=true   # only when the backend is reachable solely through your trusted proxy
