# Copy to .env locally; never commit the real .env file.
# Bootstrap username/password are used only when no .xsayatrade-data/admin.json exists.
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
# Optional for a development server behind HTTPS; production always uses Secure cookies.
# XSAYATRADE_COOKIE_SECURE=true
XSAYATRADE_ADMIN_USERNAME=admin
# Replace this example with a unique password of at least 16 characters.
XSAYATRADE_ADMIN_PASSWORD=replace-with-a-long-random-password
# Generate with: openssl rand -hex 32. Back up securely; losing it makes the encrypted vault unreadable.
XSAYATRADE_MASTER_KEY=replace-with-64-hex-characters
XSAYATRADE_DATA_DIR=.xsayatrade-data
XSAYATRADE_ENABLE_EXCHANGE_CONNECTIONS=false
XSAYATRADE_LIVE_TRADING=false
XSAYATRADE_ALLOWED_EXCHANGES=binance,okx,kucoin,nobitex,wallex,bitpin
XSAYATRADE_ORDER_QUOTE_LIMITS={"USDT":100}
XSAYATRADE_MAX_LIMIT_DEVIATION_PERCENT=2

# For production, terminate HTTPS at a trusted reverse proxy and set:
# NODE_ENV=production
# XSAYATRADE_ALLOWED_HOSTS=trade.example.com
# XSAYATRADE_ALLOWED_ORIGINS=https://trade.example.com
# Pre-approve any domain choices shown in Admin > Server management.
# XSAYATRADE_MANAGEABLE_ORIGINS=https://trade.example.com,https://trade-alt.example.com
# XSAYATRADE_TRUST_PROXY=true   # only when the backend is reachable solely through your trusted proxy
